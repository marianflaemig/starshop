<form method="post" action="{{ path('app_starship_crud_delete', {'id': starship.id}) }}"
      onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ starship.id) }}">
    <button class="mt-3 rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20">Delete</button>
</form>
