    <tr>
        <td class="p-3">
            <label for="" class="required">Status</label>
        </td>
        <td>
            {# Define current status using the form object's value #}
            {% set currentStatus = form.status.vars.value ?? 'WAITING' %}

            {# 1. The MAIN DIV container for the whole component #}
            <div data-controller="dropdown" class="relative">

                {# 2. The HIDDEN NATIVE SELECT (REQUIRED for form submission) #}
                {# We render the form widget just to get the correct name/id, then hide it #}
                {{ form_widget(form.status, {
                    'attr': {
                        'class': 'sr-only',
                        'data-dropdown-target': 'nativeSelect'
                    }
                }) }}

                {# 3. The CUSTOM SELECT BUTTON (Visible Display) #}
                <div data-dropdown-target="button"
                     data-action="click->dropdown#toggle"
                     class="w-[350px] rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20 cursor-pointer flex justify-between items-center">

                    {# Display the currently selected value #}
                    <span data-dropdown-target="display">
                        {{ currentStatus }}
                    </span>

                    {# A simple down arrow icon #}
                    <span>&#9660;</span>
                </div>

                {# 4. The CUSTOM DROPDOWN LIST (Initially Hidden) #}
                <ul data-dropdown-target="list"
                    class="hidden absolute z-10 w-[350px] mt-1 bg-gray-700 rounded-lg shadow-xl overflow-hidden text-white/90">

                    {% for option in ['WAITING', 'IN_PROGRESS', 'COMPLETED'] %}
                        {% set isSelected = (option == currentStatus) %}
                        <li data-dropdown-target="option"
                            data-value="{{ option }}"
                            data-action="click->dropdown#select"
                            class="py-2 px-5 hover:bg-white/20 cursor-pointer {{ isSelected ? 'bg-white/30 font-bold' : '' }}">
                            {{ option }}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </td>
    </tr>

</table>
{{ form_rest(form) }}
    <button class="block mt-2 mx-auto rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
