{{ form_start(form) }}
<table>
    <tr>
        <td class="p-3">
            <label for="{{ field_name(form.name) }}">Name</label>
        </td>
        <td>
            <input class="w-[350px] rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20"
                   type="text" id="{{ field_name(form.name) }}" name="{{ field_name(form.name) }}" required="required"
                   value="{{ starship.name }}">
        </td>
    </tr>
    <tr>
        <td class="p-3">
            <label for="{{ field_name(form.class) }}" class="required">Class</label>
        </td>
        <td>
            <input class="w-[350px] rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20"
                   type="text" id="{{ field_name(form.class) }}" name="{{ field_name(form.class) }}" required="required"
                   value="{{ starship.class }}">

        </td>
    </tr>
    <tr>
        <td class="p-3">
            <label for="{{ field_name(form.captain) }}" class="required">Captain</label>
        </td>
        <td>
            <input class="w-[350px] rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20"
                   type="text" id="{{ field_name(form.captain) }}" name="{{ field_name(form.captain) }}"
                   required="required"
                   value="{{ starship.captain }}">
        </td>
    </tr>
