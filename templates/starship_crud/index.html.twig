{% extends 'base.html.twig' %}

{% block title %}Starship index{% endblock %}

{% block body %}
    <div class="flex flex-col items-center">

        <h1 class="text-4xl font-semibold mb-8 mt-10">Starship index</h1>

        <table class="table">
            <thead>
            <tr>
                <th class="p-2 text-left">Id</th>
                <th class="p-2 text-left">Name</th>
                <th class="p-2 text-left">Class</th>
                <th class="p-2 text-left">Captain</th>
                <th class="p-2 text-left">Status</th>
                <th class="p-2 text-left">Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for starship in starships %}
                <tr>
                    <td class="p-2">{{ starship.id }}</td>
                    <td class="p-2">{{ starship.name }}</td>
                    <td class="p-2">{{ starship.class }}</td>
                    <td class="p-2">{{ starship.captain }}</td>
                    <td class="p-2">{{ starship.status }}</td>
                    <td>
                        <a class="rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20"
                           href="{{ path('app_starship_show', {'id': starship.id}) }}">Show</a>
                        <a class="rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20"
                           href="{{ path('app_starship_crud_edit', {'id': starship.id}) }}">Edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <a class="rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20"
           href="{{ path('app_starship_crud_new') }}">Create new</a>
    </div>
{% endblock %}
