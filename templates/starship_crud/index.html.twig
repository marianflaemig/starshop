{% block body %}
    <div class="flex flex-col items-center">

        <h1 class="text-4xl font-semibold mb-8 mt-10">Starship index</h1>

        {%  if pagination is defined %}
            <div class="mb-4 text-sm text-gray-400">
                Displaying
                {{ pagination.paginationData.firstItemNumber }}
                -
                {{ pagination.paginationData.lastItemNumber }}
                of
                {{ pagination.totalItemCount }}
                starships.
            </div>
        {% endif %}

        <table class="table">
            <thead>
            <tr>
                <th class="p-2 text-left">
                    {{  knp_pagination_sortable(pagination, 'Id', 's.id') }}
                </th>
                <th class="p-2 text-left">
                    {{  knp_pagination_sortable(pagination, 'Name', 's.name') }}
                </th>
                <th class="p-2 text-left">
                    {{  knp_pagination_sortable(pagination, 'Class', 's.class') }}
                </th>
                <th class="p-2 text-left">
                    {{  knp_pagination_sortable(pagination, 'Captain', 's.captain') }}
                </th>
                <th class="p-2 text-left">
                    {{  knp_pagination_sortable(pagination, 'Status', 's.status') }}
                </th>
            </tr>
            </thead>
            <tbody>
            {% for starship in pagination %}
                <tr>
                    <td class="p-2">{{ starship.id }}</td>
                    <td class="p-2">{{ starship.name }}</td>
                    <td class="p-2">{{ starship.class }}</td>
                    <td class="p-2">{{ starship.captain }}</td>
                    <td class="p-2">{{ starship.status }}</td>
                    <td>
                        <a class="rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20"
                           href="{{ path('app_starship_show', {'id': starship.id}) }}">Show</a>
                        <a class="rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20"
                           href="{{ path('app_starship_crud_edit', {'id': starship.id}) }}">Edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if pagination is defined and pagination.pageCount > 1 %}
            <div class="navigation flex justify-center mt-5 mb-5">
                {{ knp_pagination_render(pagination) }}
            </div>
        {% endif %}

        <a class="rounded-[60px] py-2 px-5 bg-white/10 hover:bg-white/20"
           href="{{ path('app_starship_crud_new') }}">Create new</a>
    </div>
{% endblock %}
